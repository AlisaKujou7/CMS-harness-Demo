# Local development defaults. Copy to .env. The production schema lives in cms-infra.
NODE_ENV=development
HTTP_PORT=3000
# Set to true when nginx is in front, or every client shares one rate limit bucket.
TRUST_PROXY=false
PUBLIC_URL=http://localhost:5173
CORS_ALLOWED_ORIGINS=http://localhost:5173

DATABASE_URL=postgresql://cms:cms-local-only@localhost:5432/cms?schema=public
REDIS_URL=redis://localhost:6379

# At least 64 characters. Generate with: openssl rand -hex 64
JWT_SECRET=__CHANGE_ME_64_CHAR_HEX__
# Set while rotating, so tokens signed with the old secret stay valid (07-OPS-ARCH 8.4).
JWT_SECRET_PREVIOUS=
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=14d

ARGON2_MEMORY_KB=19456
ARGON2_ITERATIONS=2
ARGON2_PARALLELISM=1

RATE_LIMIT_LOGIN_PER_MIN=10
RATE_LIMIT_PASSWORD_RESET_PER_HOUR=5
# Offices share an IP, so this allows several new people to onboard in the same hour.
RATE_LIMIT_INVITATION_PER_HOUR=30
RATE_LIMIT_PUBLIC_API_PER_MIN=60
# Spent twice, by the server and by clients, so 30 is the most FR-CONTENT-12 allows.
PUBLIC_CACHE_TTL_SEC=30

# minio needs the endpoint and both keys. s3 can use the identity of the machine instead.
OBJECT_STORAGE_PROVIDER=minio
OBJECT_STORAGE_ENDPOINT=http://localhost:9000
OBJECT_STORAGE_REGION=us-east-1
OBJECT_STORAGE_BUCKET=cms-media
OBJECT_STORAGE_ACCESS_KEY=cms-local-only
OBJECT_STORAGE_SECRET_KEY=cms-local-only-secret
# What browsers reach for uploads and downloads, when it differs from the endpoint above.
OBJECT_STORAGE_PUBLIC_URL=
MEDIA_MAX_UPLOAD_MB=20
MEDIA_UPLOAD_URL_TTL_SEC=900
MEDIA_READ_URL_TTL_SEC=3600

# The predefined list an article's category comes from (01-Requirements 6.2).
CONTENT_CATEGORIES=news,guides,announcements
# How often the worker looks for scheduled content that is due.
WORKER_SCHEDULED_PUBLISH_INTERVAL_SEC=30

# console prints emails to the log and is refused in production. ses and smtp both use SMTP.
EMAIL_PROVIDER=console
EMAIL_FROM=no-reply@cms.example.com
EMAIL_FROM_NAME=CMS
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_SECURE=true

LOG_LEVEL=info
