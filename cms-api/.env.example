# Local development defaults. Copy to .env. The production schema lives in cms-infra.
NODE_ENV=development
HTTP_PORT=3000
PUBLIC_URL=http://localhost:5173
CORS_ALLOWED_ORIGINS=http://localhost:5173

DATABASE_URL=postgresql://cms:cms-local-only@localhost:5432/cms?schema=public
REDIS_URL=redis://localhost:6379

# At least 64 characters. Generate with: openssl rand -hex 64
JWT_SECRET=__CHANGE_ME_64_CHAR_HEX__
# Set while rotating, so tokens signed with the old secret stay valid (07-OPS-ARCH 8.4).
JWT_SECRET_PREVIOUS=
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=14d

ARGON2_MEMORY_KB=19456
ARGON2_ITERATIONS=2
ARGON2_PARALLELISM=1

RATE_LIMIT_LOGIN_PER_MIN=10
RATE_LIMIT_PASSWORD_RESET_PER_HOUR=5

# console prints emails to the log and is refused in production. ses and smtp both use SMTP.
EMAIL_PROVIDER=console
EMAIL_FROM=no-reply@cms.example.com
EMAIL_FROM_NAME=CMS
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_SECURE=true

LOG_LEVEL=info
