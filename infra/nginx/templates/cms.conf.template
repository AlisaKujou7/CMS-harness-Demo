# Rendered at start by the image's entrypoint. Only variables set in the container's environment are
# replaced, so nginx's own variables pass through.

# MUI writes its styles at runtime through emotion, hence the inline styles.
map $host $spa_csp {
    default "default-src 'self'; img-src 'self' data: blob: ${MEDIA_ORIGIN}; connect-src 'self' ${MEDIA_ORIGIN}; style-src 'self' 'unsafe-inline'; font-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'";
}

# Health for the container itself, which must not depend on the certificate or the redirect.
server {
    listen 127.0.0.1:8081;
    access_log off;

    location = /healthz {
        include /etc/nginx/snippets/proxy-api.conf;
    }
}

server {
    listen 8080 default_server;
    server_name _;

    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    location / {
        return 301 ${PUBLIC_URL}$request_uri;
    }
}

server {
    listen 8443 ssl default_server;
    http2 on;
    server_name ${CMS_DOMAIN};

    ssl_certificate /etc/cms/tls/fullchain.pem;
    ssl_certificate_key /etc/cms/tls/privkey.pem;

    # A rich text body is at most 2 MB (ADR-0013), and media goes straight to storage.
    client_max_body_size 3m;

    root /usr/share/nginx/html;

    location / {
        include /etc/nginx/snippets/spa-headers.conf;
        add_header Cache-Control "no-cache" always;
        try_files $uri /index.html;
    }

    # Vite puts a content hash in these names, so a changed file is a new URL.
    location /assets/ {
        include /etc/nginx/snippets/spa-headers.conf;
        add_header Cache-Control "public, max-age=31536000, immutable" always;
        try_files $uri =404;
    }

    location /api/ {
        include /etc/nginx/snippets/proxy-api.conf;
    }

    location = /api/admin/auth/login {
        limit_req zone=login burst=20 nodelay;
        include /etc/nginx/snippets/proxy-api.conf;
    }

    location /api/v1/ {
        limit_req zone=public_api burst=300 nodelay;
        include /etc/nginx/snippets/proxy-api.conf;
    }

    location = /healthz {
        access_log off;
        include /etc/nginx/snippets/proxy-api.conf;
    }

    location = /openapi.json {
        include /etc/nginx/snippets/proxy-api.conf;
    }

    location /docs {
        include /etc/nginx/snippets/proxy-api.conf;
    }

    # Internal only (07-OPS-ARCH 15.1): this names which dependency is down.
    location = /readyz {
        return 404;
    }
}
