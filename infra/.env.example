# CMS environment. The canonical schema (07-OPS-ARCH 7.1): every variable the stack reads is here.
# scripts/generate-secrets.sh copies this to a real .env, filling each __CHANGE_ME__ with a random
# value. It cannot invent __SET_ME__ values, so those come from the provider, and scripts/deploy.sh
# refuses to run while any remain. Never commit the result, and record changes in CHANGELOG.env.md.

# Which Compose services run. Remove self-hosted-storage when media lives in an external S3 service.
COMPOSE_PROFILES=self-hosted-storage
# Which overrides scripts/compose.sh adds: prod, staging or local.
CMS_ENVIRONMENT=prod

# Deployment
NODE_ENV=production
# Where images come from, in lowercase as registries require. scripts/deploy.sh sets CMS_VERSION for
# each release.
CMS_IMAGE_REGISTRY=ghcr.io/org
# The GitHub repository whose workflow must have signed the images, spelled exactly as GitHub does,
# because the signature check is case sensitive.
CMS_GITHUB_REPO=org/cms

# Public names
CMS_DOMAIN=cms.example.com
MEDIA_DOMAIN=media.cms.example.com
PUBLIC_URL=https://cms.example.com
CORS_ALLOWED_ORIGINS=https://cms.example.com

# Host paths and ports
CMS_DATA_DIR=/var/lib/cms
CMS_TLS_DIR=/etc/cms/tls
CMS_ACME_DIR=/var/www/certbot
NGINX_HTTP_PORT=80
NGINX_HTTPS_PORT=443

# Postgres. The owner runs migrations and backups, and the API and worker connect as cms_app.
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=cms
POSTGRES_PASSWORD=__CHANGE_ME__
POSTGRES_DB=cms
CMS_APP_DB_PASSWORD=__CHANGE_ME__

# Redis holds the job queue, so it runs with noeviction (ADR-0013).
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=__CHANGE_ME__

# Object storage. `minio` means any self-hosted S3 service, addressed by path, such as the bundled
# gateway. For AWS S3 use `s3`, blank the endpoint, and run scripts/configure-s3-bucket.sh once.
OBJECT_STORAGE_PROVIDER=minio
OBJECT_STORAGE_ENDPOINT=http://object-storage:9000
OBJECT_STORAGE_REGION=us-east-1
OBJECT_STORAGE_BUCKET=cms-media
OBJECT_STORAGE_ACCESS_KEY=__CHANGE_ME__
OBJECT_STORAGE_SECRET_KEY=__CHANGE_ME__
# What browsers reach, if not the address above. Signatures cover it, so uploads and downloads go to
# this exact origin. Leave it blank for AWS S3, where the SDK puts the bucket in the host itself.
OBJECT_STORAGE_PUBLIC_URL=https://media.cms.example.com
# The origin the SPA's Content-Security-Policy allows for media. With AWS S3 it is the bucket's:
# https://<bucket>.s3.<region>.amazonaws.com
MEDIA_ORIGIN=https://media.cms.example.com
MEDIA_MAX_UPLOAD_MB=20
MEDIA_UPLOAD_URL_TTL_SEC=900
MEDIA_READ_URL_TTL_SEC=3600

# Authentication
JWT_SECRET=__CHANGE_ME_64_CHAR_HEX__
# Set while rotating, so tokens signed with the old secret stay valid (07-OPS-ARCH 8.4).
JWT_SECRET_PREVIOUS=
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=14d
ARGON2_MEMORY_KB=19456
ARGON2_ITERATIONS=2
ARGON2_PARALLELISM=1

# Rate limits and caching
RATE_LIMIT_LOGIN_PER_MIN=10
RATE_LIMIT_PASSWORD_RESET_PER_HOUR=5
RATE_LIMIT_INVITATION_PER_HOUR=30
RATE_LIMIT_PUBLIC_API_PER_MIN=60
PUBLIC_CACHE_TTL_SEC=30

# Content
CONTENT_CATEGORIES=news,guides,announcements
WORKER_SCHEDULED_PUBLISH_INTERVAL_SEC=30

# Email. ses and smtp both use SMTP, and console is refused in production.
EMAIL_PROVIDER=ses
EMAIL_FROM=no-reply@cms.example.com
EMAIL_FROM_NAME=CMS
SMTP_HOST=email-smtp.us-east-1.amazonaws.com
SMTP_PORT=587
SMTP_USER=__SET_ME__
SMTP_PASSWORD=__SET_ME__
SMTP_SECURE=true

LOG_LEVEL=info

# Smoke tests after a deploy. Blank on the first deploy, which skips that check, because no key can
# exist yet. Issue one under API Keys afterwards and set it here.
SMOKE_API_KEY=

# Off-site backups, through restic. Blank the repository to keep backups on this VM only.
BACKUP_RESTIC_REPOSITORY=s3:s3.amazonaws.com/cms-backups-offsite
BACKUP_S3_ACCESS_KEY=__SET_ME__
BACKUP_S3_SECRET_KEY=__SET_ME__
RESTIC_PASSWORD=__CHANGE_ME__
BACKUP_RETENTION_HOURLY=24
BACKUP_RETENTION_DAILY=30
BACKUP_RETENTION_WEEKLY=12
# With media in an external S3 service, the bucket to copy it to. Unused with the bundled gateway.
BACKUP_MEDIA_S3_BUCKET=
