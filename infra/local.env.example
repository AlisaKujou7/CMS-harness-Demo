# Settings for trying the whole stack on one machine with scripts/local-up.sh. It behaves as
# production does, over TLS with a self-signed certificate, with mail caught by Mailpit.
COMPOSE_PROFILES=self-hosted-storage
CMS_ENVIRONMENT=local

NODE_ENV=production
CMS_IMAGE_REGISTRY=cms-local
CMS_VERSION=local

CMS_DOMAIN=localhost
MEDIA_DOMAIN=media.localhost
PUBLIC_URL=https://localhost:8443
CORS_ALLOWED_ORIGINS=https://localhost:8443

# Unused paths are for what the local override does not replace with named volumes.
CMS_DATA_DIR=./.local/data
CMS_TLS_DIR=./.local/tls
CMS_ACME_DIR=./.local/acme
NGINX_HTTP_PORT=127.0.0.1:8080
NGINX_HTTPS_PORT=127.0.0.1:8443
MAILPIT_PORT=8025

POSTGRES_USER=cms
POSTGRES_PASSWORD=__CHANGE_ME__
POSTGRES_DB=cms
CMS_APP_DB_PASSWORD=__CHANGE_ME__

REDIS_PASSWORD=__CHANGE_ME__

OBJECT_STORAGE_PROVIDER=minio
OBJECT_STORAGE_ENDPOINT=http://object-storage:9000
OBJECT_STORAGE_BUCKET=cms-media
OBJECT_STORAGE_ACCESS_KEY=__CHANGE_ME__
OBJECT_STORAGE_SECRET_KEY=__CHANGE_ME__
OBJECT_STORAGE_PUBLIC_URL=https://media.localhost:8443
MEDIA_ORIGIN=https://media.localhost:8443

JWT_SECRET=__CHANGE_ME_64_CHAR_HEX__

EMAIL_PROVIDER=smtp
EMAIL_FROM=no-reply@cms.test
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_SECURE=false

RESTIC_PASSWORD=__CHANGE_ME__
BACKUP_RESTIC_REPOSITORY=
