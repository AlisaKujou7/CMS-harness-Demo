{
  "name": "cms-web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "openapi:types": "openapi-typescript ../cms-api/openapi.json -o src/shared/api/schema.generated.ts",
    "build": "vite build",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.browser.json",
    "depcruise": "depcruise src --config .dependency-cruiser.cjs",
    "test": "vitest run",
    "test:unit": "vitest run",
    "test:cov": "vitest run --coverage",
    "test:integration": "echo cms-web integration tests run inside the unit suite with MSW",
    "test:mutation": "stryker run",
    "test:e2e": "playwright test",
    "test:compose": "playwright test -c test/compose/playwright.config.ts"
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@fontsource-variable/roboto-flex": "^5.3.0",
    "@fontsource/roboto-mono": "^5.3.0",
    "@hookform/resolvers": "^7.0.1",
    "@mui/icons-material": "^6.5.0",
    "@mui/material": "^6.5.0",
    "@mui/utils": "^6.4.9",
    "@tanstack/react-query": "^5.105.1",
    "@tiptap/core": "^3.32.2",
    "@tiptap/extension-image": "^3.32.2",
    "@tiptap/pm": "^3.32.2",
    "@tiptap/react": "^3.32.2",
    "@tiptap/starter-kit": "^3.32.2",
    "openapi-fetch": "^0.17.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-hook-form": "^7.91.0",
    "react-router": "7.18.5",
    "rxjs": "^7.8.2",
    "zod": "^4.6.7",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.64.1",
    "@stryker-mutator/core": "^10.1.1",
    "@stryker-mutator/vitest-runner": "^10.1.1",
    "@testcontainers/postgresql": "^12.2.1",
    "@testcontainers/redis": "^12.2.1",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/coverage-v8": "^5.0.5",
    "axe-core": "^4.14.0",
    "dependency-cruiser": "^18.7.0",
    "jsdom": "^30.1.3",
    "msw": "^3.0.3",
    "openapi-typescript": "^7.13.0",
    "pg": "^8.23.1",
    "testcontainers": "^12.2.1",
    "typescript": "6.0.3",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
